{
	"name": "eigen",
	"private": true,
	"version": "0.0.1",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": "^22.13.0"
	},
	"scripts": {
		"dev": "npm run db:up && vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test:unit": "vitest --config vitest.config.ts",
		"test:coverage": "vitest run --coverage",
		"test:coverage:watch": "vitest --coverage",
		"test": "npm run test:unit:run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:up": "docker compose up -d db falkordb",
		"stack:up": "docker compose up -d --build",
		"stack:down": "docker compose down",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v",
		"db:push:force": "drizzle-kit push --force",
		"db:push": "drizzle-kit push",
		"db:migrate": "node scripts/migrate.mjs",
		"db:studio": "drizzle-kit studio",
		"db:rls": "node scripts/apply-rls.mjs",
		"eval:seed": "vite-node --config evals/vite.config.ts evals/harness/seed-fixtures.ts",
		"eval:retrieval": "vite-node --config evals/vite.config.ts evals/harness/retrieval-eval.ts",
		"eval:answer": "vite-node --config evals/vite.config.ts evals/harness/answer-eval.ts",
		"eval:agent": "vite-node --config evals/vite.config.ts evals/harness/agent-ingest-eval.ts --",
		"eval:all": "npm run eval:seed && npm run eval:retrieval && npm run eval:answer && npm run eval:agent",
		"eval:baseline": "vite-node --config evals/vite.config.ts evals/harness/promote-baseline.ts --",
		"eval:layer:embedding": "vite-node --config evals/vite.config.ts evals/layers/embedding.ts",
		"eval:layer:relations": "vite-node --config evals/vite.config.ts evals/layers/relations.ts",
		"eval:layer:entities": "vite-node --config evals/vite.config.ts evals/layers/entities.ts",
		"eval:layer:communities": "vite-node --config evals/vite.config.ts evals/layers/communities.ts",
		"eval:layer:all": "vite-node --config evals/vite.config.ts evals/layers/run-all.ts",
		"eval:golden:generate": "tsx evals/golden/generate-ground-truth.ts",
		"eval:golden": "npm run eval:golden:generate"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@inlang/paraglide-js": "^2.15.2",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/d3": "^7.4.3",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.3",
		"@vitest/coverage-v8": "^4.1.5",
		"better-auth": "~1.4.21",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"js-yaml": "^4.1.1",
		"mdsvex": "^0.12.7",
		"playwright": "^1.59.1",
		"postgres": "^3.4.9",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@fontsource/geist-mono": "^5.2.7",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/unifrakturmaguntia": "^5.2.8",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"d3": "^7.9.0",
		"falkordb": "^6.6.2",
		"umap-js": "^1.4.0",
		"zod": "^4.4.3"
	}
}
