{
  "name": "eigen",
  "private": true,
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "npm run db:up && npm run db:wait && npm run db:migrate && svelte-kit sync && vite dev --host",
    "build": "vite build && node scripts/verify-service-worker.mjs",
    "preview": "vite preview",
    "prepare": "node scripts/npm-prepare.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "ci:local": "npm run lint && npm run assert:svelte-naming && npm run check && npm run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "assert:oss-secrets": "node scripts/assert-oss-no-secrets.mjs",
    "assert:svelte-naming": "node scripts/check-svelte-naming.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:unit:run": "vitest run --config vitest.config.ts",
    "test:components": "node scripts/patch-vitest-browser-iframeid.mjs && vitest run --config vitest.browser.config.ts",
    "test:components:watch": "node scripts/patch-vitest-browser-iframeid.mjs && vitest --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test": "npm run test:unit:run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test",
    "test:e2e:release:headed": "PW_SLOW_MO=300 playwright install chromium && PW_SLOW_MO=300 playwright test src/routes/e2e/release.e2e.ts --headed",
    "db:up": "docker compose up -d --build db",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:import-graph-export": "node scripts/import-graph-export-to-age.mjs --from-export",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:push:force": "drizzle-kit push --force",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:rls": "node scripts/apply-rls.mjs",
    "db:app-role": "node scripts/ensure-app-role.mjs",
    "db:cron": "vite-node --config vitest.config.ts scripts/tick-job-queue.ts",
    "eval": "vite-node --config evals/vite.config.ts evals/run.ts",
    "eval:smoke": "vite-node --config evals/vite.config.ts evals/run.ts",
    "eval:all": "vite-node --config evals/vite.config.ts evals/run.ts -- --mode all",
    "eval:reset-fixture": "vite-node --config evals/vite.config.ts evals/reset-fixture.ts",
    "eval:longmemeval": "vite-node --config evals/vite.config.ts evals/longmemeval/run.ts",
    "graph-scale": "vite-node --config evals/vite.config.ts evals/graph-scale/run.ts",
    "graph-scale:bench": "vite-node --config evals/vite.config.ts evals/graph-scale/run.ts -- --sizes 50,100 --tracks capture,qa",
    "graph-scale:full": "vite-node --config evals/vite.config.ts evals/graph-scale/run.ts -- --sizes 50,100,250 --tracks capture,qa,consolidation",
    "test:e2e:graph-scale-spend": "playwright install chromium && GRAPH_SCALE_SPEND=1 PW_SLOW_MO=300 playwright test src/routes/e2e/graph-scale-spend.e2e.ts --headed",
    "measure:ingest": "vite-node --config evals/vite.config.ts scripts/measure-ingest-timing.ts",
    "posthog:upload-sourcemaps": "node --env-file-if-exists=.env scripts/upload-posthog-sourcemaps.mjs"
  },
  "devDependencies": {
    "@better-auth/cli": "~1.4.21",
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@inlang/paraglide-js": "^2.25.0",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.26.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/three": "^0.184.1",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "better-auth": "~1.4.21",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "js-yaml": "^5.3.0",
    "layerchart": "^2.0.0-next.48",
    "mdsvex": "^0.12.7",
    "playwright": "^1.59.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.5.0",
    "sharp": "^0.35.3",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.1",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.0.7",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/unifrakturmaguntia": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/cli": "^0.7.30",
    "@vite-pwa/sveltekit": "^1.1.0",
    "d3": "^7.9.0",
    "fflate": "^0.8.3",
    "isomorphic-dompurify": "^3.14.0",
    "marked": "^18.0.9",
    "posthog-js": "^1.393.0",
    "posthog-node": "^5.38.3",
    "three": "^0.184.0",
    "umap-js": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
