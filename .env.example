# Drizzle (default self-hosted local Postgres via `docker compose up -d db`)
# POSTGRES_USER and POSTGRES_PASSWORD are auto-generated by install.sh for production.
POSTGRES_USER="eigen"
POSTGRES_PASSWORD=""
DATABASE_URL="postgres://eigen:eigen@localhost:5432/eigen"
# Non-superuser role the app SET ROLE's into for RLS (created by npm run db:app-role)
APP_DB_ROLE="eigen_app"
EIGEN_APP_DB_PASSWORD="eigen_app"
# Superuser URL for migrations, RLS scripts, pg_cron bootstrap, consolidation run ledger
DATABASE_ADMIN_URL="postgres://eigen:eigen@localhost:5432/eigen"

ORIGIN="http://localhost:5173"

# Nightly memory consolidation (pg_cron → POST /api/admin/consolidate)
# Generate: openssl rand -hex 32
ADMIN_CONSOLIDATION_KEY=""
# App URL reachable from Postgres (Docker Compose: http://app:3000)
CONSOLIDATION_INTERNAL_URL="http://localhost:3000"
# Cron schedule and timezone (default: 02:00 UTC daily)
CONSOLIDATION_CRON_SCHEDULE="0 2 * * *"
CONSOLIDATION_CRON_TZ="UTC"

# Web Push (VAPID) — required for push notifications
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto:you@example.com or https://your-domain.example
VAPID_SUBJECT=""

# Apache AGE graph (Cypher in Postgres; must match init graph name)
AGE_GRAPH_NAME="eigen_graph"

# One-time Falkor → AGE migration only (see scripts/migrate-graph-falkor-to-age.mjs)
# FALKOR_HOST="localhost"
# FALKOR_PORT="6379"
# FALKOR_USERNAME="default"
# FALKOR_PASSWORD="eigen_falkor_dev"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Social OAuth (optional — enable only the providers you configure)
# Callback URLs: {ORIGIN}/api/auth/callback/google and {ORIGIN}/api/auth/callback/github
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Eigen service account — used when billing_mode is platform_credits (PayPal wallet)
SERVICE_API_KEY_EUROUTER=""
SERVICE_API_KEY_OPENROUTER=""
# LLM gateway origin without trailing slash (`/api/v1/chat/completions`, `/api/v1/embeddings`)
LLM_BASE_URL=""
# BYOK env fallback only (Settings → LLM → BYOK when user has not saved keys in DB)
LLM_API_KEY=""
# OpenRouter base URL — platform STT and OpenRouter BYOK fallback
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
# Optional override for speech-to-text model (default: qwen/qwen3-asr-flash-2026-02-10)
# LLM_MODEL_STT=""
# Global throttle for LLM gateway requests (milliseconds between requests).
# Default is 1000ms (1 req/s) when unset.
LLM_MIN_REQUEST_INTERVAL_MS="1000"
# Rule UUIDs: each rule carries model + routing config for that call type (JSON `rule_id` only; no separate model env).
LLM_RULE_CHAT=""
LLM_RULE_EMBEDDING=""

# PayPal (platform credit top-ups) — required for in-app purchases
# Sandbox: https://api-m.sandbox.paypal.com — Live: https://api-m.paypal.com
PAYPAL_API_BASE=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Optional: v6 JS SDK script (must match sandbox vs live Client ID). If unset, derived from PAYPAL_API_BASE.
# Sandbox: https://www.sandbox.paypal.com/web-sdk/v6/core — Live: https://www.paypal.com/web-sdk/v6/core
# PAYPAL_WEB_SDK_URL=""
# Optional: force sandbox or live SDK when API base does not contain "sandbox".
# PAYPAL_USE_SANDBOX_SDK="true"
# PAYPAL_USE_LIVE_SDK="true"

# Deterministic cavemem-style compress on text sent to the embedding API only (lite | full | ultra).
# Changing this later requires re-embedding existing thoughts for a consistent vector space.
EMBEDDING_COMPRESS_INTENSITY="full"
