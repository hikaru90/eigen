# Drizzle (see compose.yaml for local: postgres://eigen:eigen@localhost:5432/eigen)
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Backend Parakeet transcription endpoint
PARAKEET_STT_URL="http://localhost:5092/v1/audio/transcriptions"
PARAKEET_HEALTH_URL="http://localhost:5092/health"
# Optional, only needed when Parakeet auth is enabled
PARAKEET_API_KEY=""
