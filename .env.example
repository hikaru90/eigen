# Eigen environment template
#
# Local dev (npm run dev):
#   cp .env.example .env
#   npm run db:up && npm run dev
#   Use localhost URLs below (DATABASE_URL @localhost:5432, ORIGIN :5173).
#
# Docker Compose / VPS production:
#   ./install.sh --origin https://your.domain
#   (generates secrets, @db hostnames, POSTHOG_SOURCEMAPS_REQUIRED=0)
#   See docs/operations/vps-install.md

# --- Database (local dev defaults) ---
POSTGRES_USER="eigen"
POSTGRES_PASSWORD=""
DATABASE_URL="postgres://eigen:eigen@localhost:5432/eigen"
# Non-superuser role the app SET ROLE's into for RLS (created on container start)
APP_DB_ROLE="eigen_app"
EIGEN_APP_DB_PASSWORD="eigen_app"
# Superuser URL for migrations, RLS scripts, consolidation run ledger (optional; falls back to DATABASE_URL)
# DATABASE_ADMIN_URL="postgres://eigen:eigen@localhost:5432/eigen"
#
# Docker Compose production (install.sh sets these automatically):
# DATABASE_URL="postgres://eigen:<generated>@db:5432/eigen"
# DATABASE_ADMIN_URL="postgres://eigen:<generated>@db:5432/eigen"
# CONSOLIDATION_INTERNAL_URL="http://app:3000"

# Drizzle Gateway (self-hosted Studio UI at https://studio.eigenmesh.xyz — see docker-compose studio service).
# Generate: openssl rand -hex 32 — required in production / Coolify.
# First boot auto-seeds Postgres connection "eigen" via DATABASE_URL_eigen (compose → db:5432). Unlock with this password.
DRIZZLE_GATEWAY_MASTERPASS=""

ORIGIN="http://localhost:5173"
# Must match the URL you actually open (Vite defaults to :5173). Mismatch breaks /api/auth/*
# including email verification links (Better Auth only handles auth routes when origin matches).
# Docker Compose production: ORIGIN must match the public URL (e.g. https://eigen.example.com)

# Website repo: absolute URL of the product app (signup/capture CTAs). Required when website and app are on different origins.
# PUBLIC_APP_ORIGIN="https://app.example.com"

# Optional: public URL of this marketing/docs site (for cross-links from the app).
# PUBLIC_WEBSITE_ORIGIN="https://eigenmesh.xyz"

# Operator admin endpoints (reenrich, nightly consolidation, reminder dispatch cron).
# Generate: openssl rand -hex 32
# When set with DATABASE_ADMIN_URL, pg_cron jobs are registered automatically on app container boot (entrypoint.sh).
ADMIN_CONSOLIDATION_KEY=""

# Optional pg_cron overrides (defaults: job queue + reminders every minute, consolidation nightly 02:00 UTC)
# JOB_QUEUE_CRON_SCHEDULE="* * * * *"
# JOB_QUEUE_CRON_TZ="UTC"
# REMINDER_CRON_SCHEDULE="* * * * *"
# REMINDER_CRON_TZ="UTC"

# Web Push (VAPID) — required for push notifications
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto:you@example.com or https://your-domain.example
VAPID_SUBJECT=""

# Apache AGE graph (Cypher in Postgres; must match init graph name)
AGE_GRAPH_NAME="eigen_graph"

# Better Auth — required for production (install.sh generates)
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email via Owlery (transactional mail + onboarding contact book)
# Mail (verification, password reset, notifications): API key, base URL, from address.
# Onboarding list: also set contact book id (verified signups are added with subscribed: true).
OWLERY_API_KEY=""
OWLERY_BASE_URL="https://YOUR_HOST"
OWLERY_EMAIL_FROM="Eigen Mesh <hello@eigenmesh.xyz>"
OWLERY_CONTACT_BOOK_ID="aa44e40b69a24ab88cedffcd"

# Social OAuth (optional — enable only the providers you configure)
# Callback URLs: {ORIGIN}/api/auth/callback/google and {ORIGIN}/api/auth/callback/github
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Eigen service account — used when billing_mode is platform_credits (PayPal wallet)
SERVICE_API_KEY_EUROUTER=""
SERVICE_API_KEY_OPENROUTER=""
# LLM gateway origin without trailing slash (`/api/v1/chat/completions`, `/api/v1/embeddings`)
LLM_BASE_URL=""
# BYOK env fallback only (Settings → LLM → BYOK when user has not saved keys in DB)
LLM_API_KEY=""
# OpenRouter base URL — platform STT and OpenRouter BYOK fallback
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
# Optional override for speech-to-text model (default: qwen/qwen3-asr-flash-2026-02-10)
# LLM_MODEL_STT=""
# Global throttle for LLM gateway requests (milliseconds between requests).
# Default is 1000ms (1 req/s) when unset. With LLM_SERIAL_REQUESTS=1, the gap is measured
# after each request completes (no overlapping in-flight calls per user).
LLM_MIN_REQUEST_INTERVAL_MS="1000"
# Optional chat/embedding model ids when routing rules omit model (legacy fallback).
LLM_MODEL_CHAT=""
LLM_MODEL_EMBEDDING=""
# Per-request timeout in ms (default 60000 when unset).
LLM_REQUEST_TIMEOUT_MS=""
# LLM_SERIAL_REQUESTS="1"
# Parallel orchestration pools (enrich workers, eval waves). Default 8 when unset.
# LLM_ORCHESTRATION_CONCURRENCY=""
# CAPTURE_ENRICH_CONCURRENCY=""
# EVAL_ENTRY_CONCURRENCY=""
# Rule UUIDs: each rule carries model + routing config for that call type (JSON `rule_id` only; no separate model env).
LLM_RULE_CHAT=""
LLM_RULE_EMBEDDING=""

# Tenant envelope encryption (at-rest) — required for production (install.sh generates)
# wrap per-tenant DEKs using this server-side master secret
TENANT_MASTER_KEY=""

# PayPal (Eigen credit top-ups, USD settlement only) — required for in-app purchases
# REST API base only (not https://sandbox.paypal.com — that is the website, not the API).
# Sandbox (safe on prod for testing): https://api-m.sandbox.paypal.com
# Live: https://api-m.paypal.com
PAYPAL_API_BASE=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Aliases: PAYPAL_URL (same as PAYPAL_API_BASE), PAYPAL_SECRET (same as PAYPAL_CLIENT_SECRET)
# Optional: v6 JS SDK script (must match sandbox vs live Client ID). If unset, derived from PAYPAL_API_BASE.
# Sandbox: https://www.sandbox.paypal.com/web-sdk/v6/core — Live: https://www.paypal.com/web-sdk/v6/core
# PAYPAL_WEB_SDK_URL=""
# Optional: force sandbox or live SDK when API base does not contain "sandbox".
# PAYPAL_USE_SANDBOX_SDK="true"
# PAYPAL_USE_LIVE_SDK="true"
# PayPal sandbox personal buyer account for release e2e (npm run test:e2e:release:headed).
# Local Playwright e2e attaches to `npm run dev` at http://localhost:5173 — start dev before e2e.
# PAYPAL_SANDBOX_BUYER_EMAIL=""
# PAYPAL_SANDBOX_BUYER_PASSWORD=""

# ERPNext invoice sync (captured PayPal top-ups → draft Sales Invoices) — optional.
# All-or-nothing: set ALL five required vars or none (partial config hard-fails at runtime).
# REST base of your ERPNext instance, e.g. https://accounting.example.com
# ERPNEXT_BASE_URL=""
# API key + secret from ERPNext → user → Settings → API Access (needs Customer + Sales Invoice create perms)
# ERPNEXT_API_KEY=""
# ERPNEXT_API_SECRET=""
# Exact ERPNext company name the invoices are posted to
# ERPNEXT_COMPANY=""
# Service Item code used as the invoice line (e.g. EIGEN-CREDITS); must exist in ERPNext
# ERPNEXT_ITEM_CODE=""
# Optional: ERPNext Taxes and Charges Template name applied to the invoice line
# (e.g. a 0% "Kleinunternehmer § 19 UStG" template — taxes/numbering stay in ERPNext)
# ERPNEXT_TAXES_TEMPLATE=""

# BYOK settings UI: unset = show when PayPal is not configured; `true` / `false` to force on or off.
# BILLING_BYOK_UI_ENABLED="true"

# PostHog product analytics (EU cloud) — optional; disabled when unset
# Client sends events via /ingest proxy (see hooks.server.ts); server uses POSTHOG_API_KEY directly.
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_API_KEY=""
# Source map upload at Docker image build — personal API key (phx_…), NOT the project key (phc_… / POSTHOG_API_KEY).
# Create in PostHog → Settings → Personal API keys. Must be available at **build** time when required.
POSTHOG_CLI_API_KEY=""
# POSTHOG_PERSONAL_API_KEY=""  (alias accepted by upload script)
# POSTHOG_CLI_PROJECT_ID="your-posthog-project-id"
# POSTHOG_CLI_HOST="https://eu.posthog.com"
# Set to 1 only when POSTHOG_CLI_API_KEY (phx_…) is available at docker build time; otherwise builds fail.
POSTHOG_SOURCEMAPS_REQUIRED="0"

# Deterministic cavemem-style compress on text sent to the embedding API only (lite | full | ultra).
# Changing this later requires re-embedding existing thoughts for a consistent vector space.
EMBEDDING_COMPRESS_INTENSITY="full"

# Owlery (Coolify)
OWLERY_BASE_URL="baseUrl"
OWLERY_EMAIL_FROM="Eigen Mesh <test@a.de>"
OWLERY_API_KEY="apiKey"
OWLERY_CONTACT_BOOK_ID="aa44e40b69a24ab88cedffcd"